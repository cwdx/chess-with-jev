{
  "name": "@cw/chess",
  "version": "0.1.0",
  "description": "Chess and Chess960 for Jev: every legal move's facts worked out in code (exchanges, mates, threats), Jev's move as one typed Choice, and finished games replayed and scored. Built on chessops.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./rules": "./src/rules.ts",
    "./headline": "./src/headline.ts",
    "./moves": "./src/moves.ts",
    "./games": "./src/games.ts",
    "./jev-move": "./src/jev-move.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/jev": "*",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@cw/eslint-config": "*",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
